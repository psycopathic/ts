# Documents the environment variables used by the backend.
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Configure PostgreSQL before using database-backed routes.
DATABASE_URL=postgresql://postgres:password@localhost:5432/product
# Use two different strong random secrets, e.g. `openssl rand -hex 64`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
