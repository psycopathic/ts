# Documents the environment variables used by the backend.
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Configure PostgreSQL before using database-backed routes.
DATABASE_URL=postgresql://postgres:password@localhost:5432/product
# Public base URL of this API (email links, Google redirect URI).
APP_URL=http://localhost:5000
# Use two different strong random secrets, e.g. `openssl rand -hex 64`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Google OAuth; authorized redirect URI must be ${APP_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for verification and password-reset emails; emails are skipped if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
